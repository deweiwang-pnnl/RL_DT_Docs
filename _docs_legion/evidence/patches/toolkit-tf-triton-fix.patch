+# The Keras agents are imported lazily (PEP 562 module __getattr__) rather than eagerly.
+#
+# Why: importing TensorFlow installs its own CUDA stub libraries into the process. Once that
+# happens, torch.cuda.is_available() starts returning False with "Error 302: Error loading CUDA
+# libraries", the torch agents silently fall back to CPU, and any later import of triton (pulled
+# in by torch.optim) segfaults against the corrupted CUDA state. Importing every Keras agent at
+# package import time meant `import jlab_opt_control.agents` alone was enough to trigger this,
+# even for a torch-only run.
+#
+# Lazy loading keeps `TorchTD3-v0` runs entirely TensorFlow-free while leaving the Keras agents
+# fully available: the registry resolves them by string entry point at make() time, so they are
+# imported on first use with no change to their behaviour or public API.
+#
+# Note this only defers the problem for mixed runs -- a Keras agent in the same process as a torch
+# agent will still hit the CUDA conflict. Running the two frameworks separately is the supported
+# path; see _docs/strategy.md Part 2 for the longer-term "keep the torch layer TF-free" plan.
+_KERAS_AGENTS = {
+    "KerasTD3": "jlab_opt_control.agents.keras_td3",
+    "KerasREDQTD3": "jlab_opt_control.agents.keras_redq_td3",
+    "KerasDDPG": "jlab_opt_control.agents.keras_ddpg",
+    "KerasSAC": "jlab_opt_control.agents.keras_sac",
+    "KerasSINDyCriticTD3": "jlab_opt_control.agents.keras_sindy_critic_td3",
+    "KerasUncertaintyTD3": "jlab_opt_control.agents.keras_uncertainty_td3",
+    "KerasSINDyUncertaintyTD3": "jlab_opt_control.agents.keras_sindy_uncertainty_td3",
+}
+
+
+def __getattr__(name):
+    """Import a Keras agent on first attribute access (PEP 562)."""
+    if name in _KERAS_AGENTS:
+        import importlib
+
+        module = importlib.import_module(_KERAS_AGENTS[name])
+        attr = getattr(module, name)
+        globals()[name] = attr  # cache so subsequent lookups skip this path
+        return attr
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+
+
+def __dir__():
+    return sorted(list(globals()) + list(_KERAS_AGENTS))
+
 
