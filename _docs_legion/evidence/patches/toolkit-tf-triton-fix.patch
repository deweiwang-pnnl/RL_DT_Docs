+class _SummaryWriter:
+    """Minimal scalar-logging wrapper over either torch's or TF's TensorBoard writer.
+
+    Both write the same event-file format, so existing TensorBoard workflows are unaffected. The
+    backend is chosen to match the agent so that a torch-only run never imports TensorFlow.
+    """
+
+    def __init__(self, logdir, use_tensorflow):
+        self._use_tf = use_tensorflow
+        if use_tensorflow:
+            import tensorflow as tf
+            self._writer = tf.summary.create_file_writer(logdir)
+            self._writer.set_as_default()
+            self._tf = tf
+        else:
+            from torch.utils.tensorboard import SummaryWriter
+            self._writer = SummaryWriter(logdir)
+
+    def scalar(self, tag, value, step):
+        if self._use_tf:
+            self._tf.summary.scalar(tag, data=value, step=step)
+        else:
+            self._writer.add_scalar(tag, value, global_step=step)
+
+    def flush(self):
+        self._writer.flush()
