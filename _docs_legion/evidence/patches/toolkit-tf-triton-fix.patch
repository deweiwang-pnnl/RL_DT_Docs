+# Pre-load triton's native extension, unless TensorFlow has already been loaded.
+#
+# Background: torch pulls in triton (its GPU compiler) lazily -- e.g. when an Adam optimizer is
+# constructed. Triton's compiled extension (triton._C.libtriton) and TensorFlow's native libraries
+# conflict, and whichever loads *second* segfaults. Left alone, the toolkit's import order let TF
+# win that race (via the Keras agents, or via torch.utils.tensorboard, which imports TF), so triton
+# lost and the process died with SIGSEGV partway through building a torch agent.
+#
+# Loading triton here -- at the top of the package, before any submodule is imported -- makes it
+# the first of the two to initialise, after which TensorFlow loads happily alongside it.
+#
+# The `'tensorflow' not in sys.modules` guard matters: if the *caller* imported TensorFlow before
+# importing this package (several files in utests/ do exactly that, as does any TF-first user
+# script), then TF has already won and forcing triton in afterwards is precisely the ordering that
+# segfaults. In that case we leave triton alone -- torch will import it later only if a torch agent
+# is actually used, which is the pre-existing behaviour for a TF-only run.
+#
+# Deliberately best-effort: the toolkit must keep working where triton is absent (CPU-only installs,
+# non-NVIDIA machines), where the import simply fails and is ignored.
+import sys as _sys
+
+if 'tensorflow' not in _sys.modules:  # pragma: no cover - environment dependent
+    try:
+        import triton._C.libtriton  # noqa: F401
+    except Exception:  # noqa: BLE001 - any failure here is non-fatal by design
+        pass
+
